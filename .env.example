# Copy this file to `.env` and fill in real values.
# `.env` is gitignored. `.env.example` is tracked as the template.
#
# Usage:
#   cp .env.example .env
#   # then edit .env and put your real key in
#
# To load the variables into your current shell before running the script:
#   set -a; source .env; set +a
#   .venv/bin/python capstone.py
#
# Or pass inline for a single run:
#   OPENAI_API_KEY=sk-... .venv/bin/python capstone.py

# OpenAI API key used by the M4 Coach Chat (LangChain) section.
# Without this, section 4 prints a skip message and the script still completes
# every other section cleanly (AC7 - graceful degradation).
OPENAI_API_KEY=sk-replace-me
